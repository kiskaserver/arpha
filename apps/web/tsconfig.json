{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
    "types": ["vite/client", "vite-plugin-pwa/client", "geojson"],
    "noEmit": true,
    "allowJs": false,
    "checkJs": false
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.svelte",
    "test/**/*.ts",
    "vite.config.ts",
    "vitest.config.ts"
  ]
}
