# ── Server ───────────────────────────────────────────────────────────────
PORT=8080
LOG_LEVEL=info
# SQLite lives here; on Railway mount a volume at /data.
DATA_DIR=./data/runtime
# Simulated attack instead of live data (no credentials needed).
DEMO_MODE=false

# ── Telegram (MTProto, your user account) ────────────────────────────────
# 1) https://my.telegram.org → API development tools → create app
TG_API_ID=
TG_API_HASH=
# 2) `pnpm tg:login` prints this. It grants FULL access to the account — keep it secret.
TG_SESSION=
# Unlimited list: @usernames, t.me links or ids, separated by commas/newlines.
TG_CHANNELS=
# Read this many minutes of history on start.
TG_BACKFILL_MIN=30

# ── LLM extraction ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
EXTRACT_CONCURRENCY=4

# ── Air-raid alerts (https://alerts.in.ua/api-request) ───────────────────
ALERTS_IN_UA_TOKEN=
ALERTS_POLL_MS=30000

# ── Web Push (`pnpm push:keys`) ──────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
